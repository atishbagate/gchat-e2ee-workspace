{
  "manifest_version": 3,
  "name": "GChat Stealth E2EE",
  "version": "1.0.0",
  "description": "Zero-storage End-to-End Encryption for Google Chat with closed Shadow DOM and hold-to-peek privacy.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chat.google.com/*",
    "https://mail.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.google.com/*",
        "https://mail.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
